{
  "name": "@picklequeue/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build:packages": "pnpm --filter @picklequeue/contracts build && pnpm --filter @picklequeue/matchmaking build && pnpm --filter @picklequeue/scoring build",
    "postinstall": "pnpm build:packages",
    "dev": "pnpm build:packages && tsx watch src/server.ts",
    "build": "pnpm build:packages && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "lint": "pnpm build:packages && eslint src test --max-warnings=0",
    "test": "pnpm build:packages && pnpm test:packages && vitest run --config vitest.config.ts",
    "test:packages": "pnpm --filter @picklequeue/contracts test && pnpm --filter @picklequeue/matchmaking test && pnpm --filter @picklequeue/scoring test",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "pnpm build:packages && node scripts/test-integration.mjs",
    "security:ratelimit": "node scripts/security-rate-limit.mjs",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "dependencies": {
    "@picklequeue/contracts": "workspace:*",
    "@picklequeue/matchmaking": "workspace:*",
    "@picklequeue/scoring": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.13",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
